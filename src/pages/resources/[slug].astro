---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
import { toHTML } from '@portabletext/to-html';
import { getArticleCards, getArticleBySlug } from '../../lib/sanity';
import {
  APPROVED_ARTICLES,
  ARTICLE_IMAGE_FALLBACK,
  DEFAULT_ARTICLE_AUTHOR,
  formatArticleDate,
  renderArticleBlocks,
} from '../../lib/articles';
import { articleLd } from '../../lib/seo';

// One page per article: published Sanity articles (client-managed) first, then the
// approved static articles for any slug the CMS doesn't already provide.
export async function getStaticPaths() {
  const cards = await getArticleCards();
  const cmsArticles = (await Promise.all(cards.map((c) => getArticleBySlug(c.slug!)))).filter(
    (a): a is NonNullable<typeof a> => Boolean(a?.slug)
  );

  const cmsPaths = cmsArticles.map((a) => ({
    params: { slug: a.slug },
    props: {
      article: {
        title: a.title,
        slug: a.slug,
        summary: a.summary,
        image: a.coverImage ?? ARTICLE_IMAGE_FALLBACK[a.slug ?? ''],
        bodyHtml: Array.isArray(a.body) ? toHTML(a.body) : '',
        disclaimer: (a as { disclaimer?: string }).disclaimer ?? '',
        sourceNote: (a as { sourceNote?: string }).sourceNote ?? '',
        seoTitle: a.seoTitle,
        seoDescription: a.seoDescription,
        publishedAt: a.publishedAt,
        author: (a as { author?: string }).author,
      },
    },
  }));

  const cmsSlugs = new Set(cmsArticles.map((a) => a.slug));
  const staticPaths = APPROVED_ARTICLES.filter((a) => !cmsSlugs.has(a.slug)).map((a) => ({
    params: { slug: a.slug },
    props: {
      article: {
        title: a.title,
        slug: a.slug,
        summary: a.summary,
        image: a.image,
        bodyHtml: renderArticleBlocks(a.body),
        disclaimer: a.disclaimer,
        sourceNote: a.sourceNote,
        seoTitle: undefined,
        seoDescription: a.summary,
        publishedAt: a.publishedAt,
        author: undefined,
      },
    },
  }));

  return [...cmsPaths, ...staticPaths];
}

const { article } = Astro.props;
const publishedLabel = formatArticleDate(article.publishedAt);
const author = article.author || DEFAULT_ARTICLE_AUTHOR;
---

<BaseLayout
  title={article.seoTitle || `${article.title} - FWP Advisory`}
  description={article.seoDescription || article.summary || ''}
  type="article"
  jsonLd={[articleLd({ ...article, coverImage: article.image }, Astro.site)]}
>
  <article class="relative z-10 mx-auto max-w-3xl px-6 pb-28 pt-16 lg:px-8 lg:pt-24">
    <a
      href="/resources"
      class="inline-flex items-center text-sm font-semibold text-[#6FD7E3] hover:text-[#8FE3EC]"
    >
      <ArrowLeft className="mr-2 h-4 w-4" /> All resources
    </a>

    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-5xl">
      {article.title}
    </h1>
    {
      publishedLabel && (
        <p class="mt-5 text-sm text-white/45">
          Published <time datetime={article.publishedAt}>{publishedLabel}</time>
        </p>
      )
    }
    {article.summary && <p class="mt-6 text-lg leading-8 text-white/72">{article.summary}</p>}
    {
      article.image && (
        <img
          src={article.image}
          alt=""
          class="mt-8 aspect-[16/9] w-full rounded-3xl border border-white/10 object-cover"
        />
      )
    }
    {article.bodyHtml && <div class="article-body mt-10" set:html={article.bodyHtml} />}

    {/* Author block */}
    <div
      class="mt-12 flex items-center gap-4 rounded-3xl border border-[#6FD7E3]/20 bg-[#6FD7E3]/10 p-6"
    >
      <img src="/fwp-shield.png" alt="" class="h-12 w-auto shrink-0" />
      <div>
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-[#8FE3EC]">
          Written by
        </div>
        <div class="mt-1 text-base font-semibold text-white">{author}</div>
        {
          publishedLabel && (
            <div class="mt-1 text-sm text-white/50">
              Published <time datetime={article.publishedAt}>{publishedLabel}</time>
            </div>
          )
        }
      </div>
    </div>

    {
      article.disclaimer && (
        <p class="mt-12 rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-sm leading-6 text-white/55">
          {article.disclaimer}
        </p>
      )
    }
    {
      article.sourceNote && (
        <p class="mt-4 text-xs leading-6 text-white/40">
          <span class="font-semibold text-white/60">Source note:</span> {article.sourceNote}
        </p>
      )
    }
  </article>
</BaseLayout>
