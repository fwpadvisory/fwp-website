---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { ArrowRight, Download, FileText } from 'lucide-react';
import { getArticleCards } from '../lib/sanity';
import { APPROVED_ARTICLE_CARDS, ARTICLE_IMAGE_FALLBACK, formatArticleDate } from '../lib/articles';
import { BROCHURES } from '../lib/site';

// Simplified Resources page (per client brief): intro, free guide, featured video,
// guides & brochures, Latest Articles, discovery CTA. No categories or filters.
// Latest Articles = client-published Sanity articles merged with the approved articles,
// newest first. Future articles added in /studio appear here automatically.
const cms = await getArticleCards();
const cmsSlugs = new Set(cms.map((a) => a.slug));
const articles = [...cms, ...APPROVED_ARTICLE_CARDS.filter((a) => !cmsSlugs.has(a.slug))].sort(
  (a, b) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? '')
);

const VIDEO_ID = 'xHpmte7mdYM';
const VIDEO_TITLE = 'Five Asset Protection Risks People Often Miss';
---

<BaseLayout
  title="Resources - FWP Advisory"
  description="Practical guides, a short video, and articles on asset protection, succession, and family wealth risk."
>
  <PageHero
    label="Resources"
    title="Practical resources on asset protection, succession, and family wealth"
    body="A free guide, a short video, and plain-English articles for business owners, families, and asset holders who want to understand risk, structures, and control."
    booking={false}
  />

  <section class="relative z-10 mx-auto max-w-7xl px-6 pb-24 lg:px-8">
    {/* Free guide */}
    <div
      class="grid gap-8 rounded-[2rem] border border-[#6FD7E3]/20 bg-[#6FD7E3]/10 p-8 md:p-10 lg:grid-cols-[1fr_auto] lg:items-center"
    >
      <div>
        <SectionLabel>Free guide</SectionLabel>
        <h2 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">
          The Guide to Protecting Family Wealth
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-white/70">
          Download the guide if you are interested in asset protection and succession planning, but
          not ready to book a Discovery Meeting yet.
        </p>
      </div>
      <div class="shrink-0">
        <Button href="/guide">Get the free guide <ArrowRight className="ml-2 h-4 w-4" /></Button>
      </div>
    </div>

    {/* Featured video */}
    <div class="mt-16">
      <SectionLabel>Featured video</SectionLabel>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white md:text-4xl">
        {VIDEO_TITLE}
      </h2>
      <div
        class="mt-7 aspect-video w-full overflow-hidden rounded-3xl border border-white/10 bg-black"
      >
        <iframe
          class="h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}`}
          title={VIDEO_TITLE}
          loading="lazy"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen></iframe>
      </div>
    </div>

    {/* Guides & brochures */}
    <div class="mt-16">
      <SectionLabel>Guides & brochures</SectionLabel>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white md:text-4xl">
        Free downloadable guides
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-white/70">
        Plain-English brochures on common tax, super, and business issues. General information only -
        not legal, tax, or financial advice.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          BROCHURES.map((b) => (
            <article class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.04] p-7">
              <FileText className="mb-5 h-8 w-8 text-[#6FD7E3]" />
              <h3 class="text-xl font-semibold leading-7 text-white">{b.title}</h3>
              <p class="mt-4 flex-1 text-sm leading-6 text-white/65">{b.description}</p>
              <a
                href={b.file}
                download
                class="mt-6 inline-flex items-center text-sm font-semibold text-[#6FD7E3] hover:text-[#8FE3EC]"
              >
                <Download className="mr-2 h-4 w-4" /> Download PDF
              </a>
            </article>
          ))
        }
      </div>
    </div>

    {/* Latest articles */}
    <div class="mt-16">
      <SectionLabel>Latest articles</SectionLabel>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white md:text-4xl">
        Latest articles
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          articles.map((item) => (
            <article class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04]">
              {(item.image ?? ARTICLE_IMAGE_FALLBACK[item.slug ?? '']) && (
                <img
                  src={item.image ?? ARTICLE_IMAGE_FALLBACK[item.slug ?? '']}
                  alt=""
                  class="aspect-[16/9] w-full object-cover"
                />
              )}
              <div class="flex flex-1 flex-col p-7">
                {formatArticleDate(item.publishedAt) && (
                  <time datetime={item.publishedAt} class="mb-3 block text-xs font-medium uppercase tracking-[0.14em] text-white/40">
                    {formatArticleDate(item.publishedAt)}
                  </time>
                )}
                <h3 class="text-lg font-semibold leading-7 text-white">{item.title}</h3>
                <p class="mt-4 flex-1 text-sm leading-6 text-white/65">{item.summary}</p>
                {item.slug && (
                  <a
                    href={`/resources/${item.slug}`}
                    class="mt-6 inline-flex items-center text-sm font-semibold text-[#6FD7E3] hover:text-[#8FE3EC]"
                  >
                    Read article <ArrowRight className="ml-2 h-4 w-4" />
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
