---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FinalCTA from '../components/FinalCTA.astro';

const steps = [
  {
    n: '1',
    title: 'Discovery Meeting',
    text: 'Together, we complete your Family Wealth Protection Assessment to understand your circumstances, assets and existing protections. After the discovery meeting, you’ll receive a free, personalised Asset Protection Gap Report identifying potential gaps in your current asset protection.',
  },
  {
    n: '2',
    title: 'Asset Protection Blueprint',
    text: 'I review the findings in your Asset Protection Gap Report and develop a personalised strategy to address them. Your Asset Protection Blueprint outlines the recommended structures and actions to better protect your family’s wealth. A separate professional fee applies.',
  },
  {
    n: '3',
    title: 'Blueprint Implementation',
    text: 'I walk you through your Asset Protection Blueprint, answer your questions and explain the recommended implementation process and costs. If you choose to proceed, I coordinate the work required to put your Blueprint in place. The professional fee for Step 2 is credited towards implementation, with no obligation to proceed.',
  },
];
---

<BaseLayout
  title="Process - FWP Advisory"
  description="A clear process before implementation begins: Discovery Meeting and Asset Protection Gap Report, Asset Protection Blueprint, and Blueprint Implementation."
>
  <PageHero
    label="Process"
    title="A Clear Process Before Implementation Begins"
    body="The process is designed to help you understand where your protection has gaps, receive a personalised Asset Protection Blueprint, and decide whether implementation is appropriate for your circumstances."
  />

  {/* One subtle page-level pathway image near the introduction. The three numbered
      steps below stay image-free. */}
  <section class="relative z-10 mx-auto max-w-5xl px-6 pb-12 lg:px-8">
    <div class="relative h-48 overflow-hidden rounded-[2rem] border border-white/10 md:h-60">
      <img
        src="/images/process-doorway.jpg"
        alt=""
        loading="lazy"
        class="h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0E1020] via-[#0E1020]/35 to-transparent">
      </div>
    </div>
  </section>

  <section class="relative z-10 mx-auto max-w-5xl px-6 pb-24 lg:px-8">
    <div class="space-y-6">
      {
        steps.map(({ n, title, text }) => (
          <div class="grid gap-6 rounded-3xl border border-white/10 bg-white/[0.04] p-8 md:grid-cols-[80px_1fr] md:p-10">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#6FD7E3] text-lg font-bold text-[#0E1020]">
              {n}
            </div>
            <div>
              <h2 class="text-2xl font-semibold text-white">{title}</h2>
              <p class="mt-4 text-lg leading-8 text-white/70">{text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
